# Local environment files; keep shareable examples and templates.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template

# Python virtual environments and bytecode.
.venv/
venv/
env/
ENV/
__pypackages__/
__pycache__/
*.py[cod]
*$py.class

# Python build and packaging outputs.
build/
dist/
.eggs/
*.egg-info/
*.egg
*.whl
pip-wheel-metadata/

# Test, coverage, lint, and type-checker outputs.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml

# Runtime logs and process files.
*.log
*.log.*
*.pid
*.pid.lock

# Uploaded resumes; retain the directory placeholder.
/internships/data/uploads/*
!/internships/data/uploads/.gitkeep

# Local editor settings and temporary files.
.idea/
.vscode/
*.swp
*.swo
*~

# Operating system metadata.
.DS_Store
._*
Thumbs.db
Desktop.ini
